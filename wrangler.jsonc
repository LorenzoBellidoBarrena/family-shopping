{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-shopping",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/family-shopping/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-shopping-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "database/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD_COORDINATOR", "class_name": "HouseholdCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdCoordinator"] }],
  "observability": { "enabled": true },
}
