{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-shopping",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/family-shopping/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/ws", "/ws/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-shopping-db",
      "database_id": "2b8fa0c2-87c7-4e22-ac83-6f44110db302",
      "migrations_dir": "database/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "HOUSEHOLD_COORDINATOR", "class_name": "HouseholdCoordinator" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdCoordinator"] }],
  "vars": { "SUPERMARKET_FEATURE_ENABLED": "true" },
  "triggers": { "crons": ["0 3 * * *", "0 4 * * *"] },
  "observability": { "enabled": true },
}
